<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMusic.Views.CadastroPage"
             Background="#000000">
    <VerticalStackLayout>
        <Image Source="logo_music.png" WidthRequest="325" HeightRequest="254"/>
        <Label Text="Let’s get you in" FontFamily="DidactGothic" TextColor="White" FontSize="44" HorizontalOptions="Center"></Label>
        <Button ImageSource="google_icon.png"
              Text="Continue with Google"
              BackgroundColor="#1E1E1E"
              TextColor="White"
              FontSize="20"
              FontFamily="DidactGothic"
              HeightRequest="50"
              WidthRequest="310"
              HorizontalOptions="Center"
                  Margin="0,50,0,0" BorderColor="#DBE7E8" BorderWidth="0.2"/>

        <Button ImageSource="facebook_icon.png"
                  Text="Continue with Facebook"
                  BackgroundColor="#1E1E1E"
                  TextColor="White"
                  FontSize="20"
                  FontFamily="DidactGothic"
                  HeightRequest="50"
                  WidthRequest="310"
                  HorizontalOptions="Center"
                      Margin="0,20,0,0" BorderColor="#DBE7E8" BorderWidth="0.2"/>

        <Button ImageSource="apple_icon.png"
                      Text=" Continue with Apple"
                      BackgroundColor="#1E1E1E"
                      TextColor="White"
                      FontSize="20"
                      FontFamily="DidactGothic"
                      HeightRequest="50"
                      WidthRequest="310"
                      HorizontalOptions="Center"
                      Margin="0,20,0,0" BorderColor="#DBE7E8" BorderWidth="0.2"/>

        <HorizontalStackLayout HorizontalOptions="Center" Margin="0,20,0,0">
            <Line X1="0" Y1="0" X2="137" Y2="0" Stroke="White" StrokeThickness="0.8" VerticalOptions="Center"/>
            <Label Text=" or " TextColor="White"></Label>
            <Line X1="0" Y1="0" X2="137" Y2="0" Stroke="White" StrokeThickness="0.8" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <Button
              Text="Log in with a password"
              BackgroundColor="#35BED1"
              TextColor="White"
              FontSize="16"
                    FontFamily="Mulish"
              CornerRadius="20"
              HeightRequest="50"
              WidthRequest="310"
              HorizontalOptions="Center"
              Margin="0,20,0,0"
            Clicked="LoginPage"
              />
        <Label FontFamily="DidactGothic" FontSize="15" VerticalOptions="Start" HorizontalOptions="Center" Padding="10" VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Don’t have an account? " TextColor="White"/>
                    <Span Text="Sign Up" TextColor="#76D7E6"/>
                </FormattedString>
            </Label.FormattedText>
        </Label>

    </VerticalStackLayout>
</ContentPage>
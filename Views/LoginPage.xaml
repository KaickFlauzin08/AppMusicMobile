<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMusic.Views.LoginPage"
             Background="Black">
    <VerticalStackLayout>
        <Image Source="logo_music.png" WidthRequest="325" HeightRequest="275"/>
        <Label Text="Login to your account" FontFamily="DidactGothic" TextColor="White" FontSize="32" HorizontalOptions="Center"></Label>

        <HorizontalStackLayout>
            <Border Background="#1E1E1E">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>

                <Grid ColumnDefinitions="Auto, *" 
          Padding="15,0" 
          VerticalOptions="Center">
                    <Image Grid.Column="0" 
               Source="face_preto.png" 
               WidthRequest="24" 
               HeightRequest="24" 
               VerticalOptions="Center" 
               Margin="0,0,10,0"/>
                    
                    <Entry Grid.Column="1" 
               Placeholder="Email" 
               PlaceholderColor="#888888"
               TextColor="White"
               BackgroundColor="Transparent" 
               VerticalOptions="Center" WidthRequest="300"/>
                </Grid>

            </Border>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppMusic.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppMusic"
    Shell.FlyoutBehavior="Disabled"
    xmlns:views="clr-namespace:AppMusic.Views"
    Title="AppMusic"
    Shell.BackgroundColor="#000000"
    Shell.ForegroundColor="#FFFFFF">

    <ShellContent ContentTemplate ="{DataTemplate views:HomePage}" Route="HomePage" Title="Initial"/>
    <ShellContent ContentTemplate ="{DataTemplate views:LoginPage}" Route="LoginPage" Title="LoginPage"/>


</Shell>
